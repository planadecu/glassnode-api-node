# Supply-chain hardening for npm in this sub-project. npm does not read the root .npmrc here (its
# own package.json makes examples/ the project root), so the root's ignore-scripts is repeated.
# This file covers ignore-scripts only: the root's minimum-release-age is a pnpm setting that npm
# ignores. To keep the same 7-day rule with npm, add or update dependencies with
# `npm install --before=<date 7 days ago>` (as used when package-lock.json was regenerated), and
# install with `npm ci`, which only installs what the lockfile pins.
ignore-scripts=true
